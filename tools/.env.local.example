# 複製此檔為 tools/.env.local 後填入實際值 (.env.local 已被 gitignore)
# 稽核腳本會分別用 FREE 和 PAID 兩把 key 各執行一次 ListModels + 實測翻譯

GEMINI_API_KEY_FREE=your_free_tier_key_here
GEMINI_API_KEY_PAID=your_paid_tier_key_here

# LINE Messaging API (long-lived channel access token)
LINE_CHANNEL_ACCESS_TOKEN=your_channel_token_here
LINE_USER_ID=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
